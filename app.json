{
  "expo": {
    "name": "FrankiFlow Admin App",
    "slug": "frankiflow-admin",
    "version": "1.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.frankiflow.admin",
      "buildNumber": "4",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.frankiflow.admin",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#051C3F"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FrankiFlow Admin App uses your photo library only when you choose an image for FrankiFlow or FrankiHolz content.",
          "cameraPermission": "FrankiFlow Admin App uses the camera only when you choose to take a photo for business content.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
